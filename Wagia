-- ============ REMOTE SPY ============
-- Hook __namecall + FireServer/InvokeServer để bắt mọi remote người chơi gửi lên
local SpyLog = {}
local SPY_MAX = 200
local spyBox -- gán khi dựng tab

local function dinhDangArg(a)
    local t = typeof(a)
    if t == "Instance" then
        return a:GetFullName()
    elseif t == "string" then
        if #a > 40 then return '"' .. a:sub(1, 40) .. '…"' end
        return '"' .. a .. '"'
    elseif t == "number" or t == "boolean" then
        return tostring(a)
    elseif t == "Vector3" then
        return string.format("V3(%.1f,%.1f,%.1f)", a.X, a.Y, a.Z)
    elseif t == "CFrame" then
        return "CFrame"
    elseif t == "table" then
        return "{table:" .. tostring(#a) .. "}"
    else
        return tostring(t)
    end
end

local function ghiLog(remote, method, args)
    if not State.Spy then return end
    local tenRemote
    if typeof(remote) == "Instance" then
        tenRemote = remote:GetFullName()
    else
        tenRemote = tostring(remote)
    end
    local argStr = {}
    for i = 1, math.min(#args, 8) do
        argStr[i] = dinhDangArg(args[i])
    end
    local line = string.format("[%s] %s(%s)",
        method, tenRemote, table.concat(argStr, ", "))
    table.insert(SpyLog, 1, line)
    if #SpyLog > SPY_MAX then table.remove(SpyLog) end
    if spyBox then
        spyBox.Text = table.concat(SpyLog, "\n")
    end
end

local function hookRemote()
    -- Hook __namecall (đa số remote đi qua đây)
    local mt = getrawmetatable and getrawmetatable(game)
    if mt and setreadonly and hookfunction then
        local oldNamecall = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod and getnamecallmethod() or ""
            local args = {...}
            if method == "FireServer" or method == "InvokeServer" then
                pcall(ghiLog, self, method, args)
            end
            return oldNamecall(self, ...)
        end)
        setreadonly(mt, true)
    end

    -- Hook thêm __index cho FireServer/InvokeServer trực tiếp
    if hookmetamethod and newcclosure then
        local oldIndex
        oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
            if key == "FireServer" or key == "InvokeServer" then
                return newcclosure(function(_, ...)
                    pcall(ghiLog, self, key, {...})
                    return oldIndex(self, key)(_, ...)
                end)
            end
            return oldIndex(self, key)
        end))
    end
end

-- ============ VULN SCANNER ============
-- Quét tất cả RemoteEvent/RemoteFunction trong game, dò dấu hiệu thiếu validate
-- (không chắc chắn 100%, chỉ là gợi ý để thử nghiệm)
local vulnKetQua = {}
local vulnBox

local function quetLohong()
    vulnKetQua = {}
    local dem = 0
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")
        or obj:IsA("UnreliableRemoteEvent") then
            dem += 1
            local ten = obj:GetFullName()
            local canhBao = {}
            -- Dấu hiệu: tên gợi ý hành động nhạy cảm
            local lower = string.lower(ten)
            if lower:find("damage") or lower:find("hit")
            or lower:find("attack") or lower:find("punch")
            or lower:find("kill")    or lower:find("hurt") then
                table.insert(canhBao, "tên liên quan sát thương — thử spam arg")
            end
            if lower:find("money") or lower:find("coin")
            or lower:find("cash")  or lower:find("buy")
            or lower:find("shop")  or lower:find("purchase") then
                table.insert(canhBao, "tên liên quan tiền tệ — thử arg âm / số lớn")
            end
            if lower:find("admin") or lower:find("ban")
            or lower:find("kick")  or lower:find("give")
            or lower:find("grant") or lower:find("set") then
                table.insert(canhBao, "tên quyền hạn — thử leo quyền")
            end
            if lower:find("speed") or lower:find("walk")
            or lower:find("jump")  or lower:find("teleport")
            or lower:find("tp") then
                table.insert(canhBao, "tên di chuyển — thử set giá trị cực đại")
            end
            -- RemoteFunction dễ dính hơn vì server trả giá trị cho client
            if obj:IsA("RemoteFunction") then
                table.insert(canhBao, "RemoteFunction — dễ lộ data server")
            end
            local entry = string.format("• %s", ten)
            if #canhBao > 0 then
                entry = entry .. "\n   ⚠ " .. table.concat(canhBao, " | ")
            else
                entry = entry .. "\n   (không có dấu hiệu rõ, vẫn thử được)"
            end
            table.insert(vulnKetQua, entry)
        end
    end
    table.sort(vulnKetQua)
    local header = string.format("Đã quét %d remote.\n\n", dem)
    if vulnBox then
        vulnBox.Text = header .. table.concat(vulnKetQua, "\n\n")
    end
end

