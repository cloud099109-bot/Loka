local function addToggle(label, description, callback)
    local row = create("Frame", {
        Name = label:gsub("%s+", ""),
        Size = UDim2.new(1, -2, 0, 52),
        BackgroundColor3 = COLORS.Row,
        BorderSizePixel = 0,
    }, Content)
    corner(row, 9)

    create("TextLabel", {
        Position = UDim2.fromOffset(11, 7),
        Size = UDim2.new(1, -86, 0, 19),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = COLORS.Text,
        TextSize = 12,
        Font = Enum.Font.GothamSemibold,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    create("TextLabel", {
        Position = UDim2.fromOffset(11, 27),
        Size = UDim2.new(1, -86, 0, 15),
        BackgroundTransparency = 1,
        Text = description or "",
        TextColor3 = COLORS.Muted,
        TextSize = 9,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, row)

    local enabled = false

    local button = create("TextButton", {
        Position = UDim2.new(1, -64, 0.5, -12),
        Size = UDim2.fromOffset(53, 25),
        BackgroundColor3 = COLORS.Background,
        BorderSizePixel = 0,
        Text = "OFF",
        TextColor3 = COLORS.Muted,
        TextSize = 10,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = true,
    }, row)
    corner(button, 8)

    local function render()
        button.BackgroundColor3 = enabled and COLORS.Active
            or COLORS.Background
        button.TextColor3 = enabled and Color3.new(1, 1, 1)
            or COLORS.Muted
        button.Text = enabled and "ON" or "OFF"
    end

    local function setEnabled(value)
        if enabled == value then
            return
        end

        enabled = value
        render()

        local ok, err = pcall(callback, enabled)
        if not ok then
            warn("[Axiom] " .. label .. ": " .. tostring(err))
            enabled = false
            render()
            pcall(callback, false)
        end
    end

    track(button.Activated:Connect(function()
        setEnabled(not enabled)
    end))

    return {
        Set = setEnabled,
        Get = function()
            return enabled
        end,
    }
end

--==================================================
-- Player outlines for Studio testing
--==================================================

local function removeHighlight(player)
    local highlight = Highlights[player]
    if highlight then
        highlight:Destroy()
        Highlights[player] = nil
    end
end

local function addHighlight(player)
    if player == LocalPlayer or not State.ESP then
        return
    end

    local character = player.Character
    if not character then
        return
    end

    local old = Highlights[player]
    if old and old.Parent == character then
        return
    end

    removeHighlight(player)

    local highlight = Instance.new("Highlight")
    highlight.Name = "AxiomDebugHighlight"
    highlight.Adornee = character
    highlight.FillColor = Color3.fromRGB(105, 105, 255)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.82
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.Occluded
    highlight.Parent = character

    Highlights[player] = highlight
end

local function refreshHighlights()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if State.ESP then
                addHighlight(player)
            else
                removeHighlight(player)
            end
        end
    end
end

local function setupPlayer(player)
    if player == LocalPlayer then
        return
    end

    local conn = player.CharacterAdded:Connect(function()
        task.wait(0.25)
        if State.ESP then
            addHighlight(player)
        end
    end)
    table.insert(CharacterConnections, conn)

    if State.ESP then
        addHighlight(player)
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    setupPlayer(player)
end

track(Players.PlayerAdded:Connect(setupPlayer))

track(Players.PlayerRemoving:Connect(function(player)
    removeHighlight(player)
end))

--==================================================
-- Performance mode
--==================================================

local function applyPerformance(enabled)
    if enabled then
        OriginalLighting.GlobalShadows = Lighting.GlobalShadows
        OriginalLighting.FogEnd = Lighting.FogEnd
        OriginalLighting.EnvironmentDiffuseScale =
            Lighting.EnvironmentDiffuseScale
        OriginalLighting.EnvironmentSpecularScale =
            Lighting.EnvironmentSpecularScale

        Lighting.GlobalShadows = false
        Lighting.FogEnd = 100000
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0

        for _, object in ipairs(Workspace:GetDescendants()) do
            if object:IsA("ParticleEmitter")
                or object:IsA("Trail")
                or object:IsA("Beam")
                or object:IsA("Fire")
                or object:IsA("Smoke")
                or object:IsA("Sparkles") then

                if OriginalVisuals[object] == nil then
                    OriginalVisuals[object] = object.Enabled
                end
                object.Enabled = false
            end
        end
    else
        for property, value in pairs(OriginalLighting) do
            pcall(function()
                Lighting[property] = value
            end)
        end
        table.clear(OriginalLighting)

        for object, wasEnabled in pairs(OriginalVisuals) do
            if object and object.Parent then
                pcall(function()
                    object.Enabled = wasEnabled
                end)
            end
        end
        table.clear(OriginalVisuals)
    end
end

track(Workspace.DescendantAdded:Connect(function(object)
    if not State.Performance then
        return
    end

    if object:IsA("ParticleEmitter")
        or object:IsA("Trail")
        or object:IsA("Beam")
        or object:IsA("Fire")
        or object:IsA("Smoke")
        or object:IsA("Sparkles") then

        if OriginalVisuals[object] == nil then
            OriginalVisuals[object] = object.Enabled
        end
        object.Enabled = false
    end
end))

--==================================================
-- Movement controls
--==================================================

local function applyMovement()
    local _, humanoid = getCharacter()
    if not humanoid then
        return
    end

    humanoid.WalkSpeed = State.Speed and Config.WalkSpeed or 16

    if humanoid.UseJumpPower then
        humanoid.JumpPower =
            State.HighJump and Config.JumpPower or 50
    else
        humanoid.JumpHeight =
            State.HighJump and 12 or 7.2
    end
end

local function stopFly()
    disconnect(FlyConnection)
    FlyConnection = nil

    if FlyVelocity then
        FlyVelocity:Destroy()
        FlyVelocity = nil
    end

    if FlyOrientation then
        FlyOrientation:Destroy()
        FlyOrientation = nil
    end

    if FlyAttachment then
        FlyAttachment:Destroy()
        FlyAttachment = nil
    end

    if Humanoid then
        Humanoid.AutoRotate = true
        if Humanoid.Health > 0 then
            Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end
end

local function startFly()
    local _, humanoid, root = getCharacter()
    if not humanoid or not root then
        return
    end

    stopFly()

    FlyAttachment = Instance.new("Attachment")
    FlyAttachment.Name = "AxiomFlyAttachment"
    FlyAttachment.Parent = root

    FlyVelocity = Instance.new("LinearVelocity")
    FlyVelocity.Name = "AxiomFlyVelocity"
    FlyVelocity.Attachment0 = FlyAttachment
    FlyVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    FlyVelocity.VelocityConstraintMode =
        Enum.VelocityConstraintMode.Vector
    FlyVelocity.VectorVelocity = Vector3.zero
    FlyVelocity.MaxForce = 100000
    FlyVelocity.Parent = root

    FlyOrientation = Instance.new("AlignOrientation")
    FlyOrientation.Name = "AxiomFlyOrientation"
    FlyOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
    FlyOrientation.Attachment0 = FlyAttachment
    FlyOrientation.MaxTorque = 100000
    FlyOrientation.Responsiveness = 15
    FlyOrientation.Parent = root

    humanoid.AutoRotate = false
    humanoid:ChangeState(Enum.HumanoidStateType.Physics)

    FlyConnection = RunService.RenderStepped:Connect(function()
        if not State.Fly then
            stopFly()
            return
        end

        if not root.Parent or humanoid.Health <= 0 then
            stopFly()
            return
        end

        local camera = Workspace.CurrentCamera
        if not camera then
            return
        end

        local forward = camera.CFrame.LookVector
        local right = camera.CFrame.RightVector

        local direction = Vector3.zero

        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            direction += forward
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            direction -= forward
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            direction += right
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            direction -= right
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            direction += Vector3.yAxis
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            direction -= Vector3.yAxis
        end

        if direction.Magnitude > 0 then
            direction = direction.Unit
        end

        FlyVelocity.VectorVelocity = Vector3.new(
            direction.X * Config.FlySpeed,
            direction.Y * Config.FlyVerticalSpeed,
            direction.Z * Config.FlySpeed
        )

        local flatLook = Vector3.new(forward.X, 0, forward.Z)
        if flatLook.Magnitude > 0.001 then
            FlyOrientation.CFrame = CFrame.lookAt(
                Vector3.zero,
                flatLook.Unit
            )
        end
    end)
end

track(UserInputService.JumpRequest:Connect(function()
    if not State.InfiniteJump then
        return
    end

    local _, humanoid = getCharacter()
    if humanoid and humanoid.Health > 0 then
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end))

