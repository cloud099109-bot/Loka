local function makeBox(order, placeholder, initial, minV, maxV, onChange)
    local box = Instance.new("TextBox")
    box.LayoutOrder = order
    box.Size = UDim2.new(1, -8, 0, 32)
    box.PlaceholderText = placeholder
    box.Text = tostring(initial)
    box.ClearTextOnFocus = false
    style(box, C.input)
    box.TextSize = 13
    box.Parent = rightCol
    box.FocusLost:Connect(function()
        local v = tonumber(box.Text)
        if v then onChange(math.clamp(v, minV, maxV)) end
        box.Text = tostring(initial and (placeholder:find("bay") and travelSpeed or stepDistance) or initial)
        box.Text = tostring(placeholder:find("bay") and travelSpeed or stepDistance)
    end)
    return box
end

