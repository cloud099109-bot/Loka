-- ===== AIMBOT =====
local aimbotConn
local function getClosestPlayer()
    local closestPlayer, shortest = nil, math.huge
    local mouseLoc = UIS:GetMouseLocation()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local head = p.Character:FindFirstChild("Head")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if head and hum and hum.Health > 0 then
                local sp, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local d = (Vector2.new(sp.X, sp.Y) - mouseLoc).Magnitude
                    if d < shortest then shortest = d; closestPlayer = p end
                end
            end
        end
    end
    return closestPlayer
end

local function setAimbot(on)
    if aimbotConn then aimbotConn:Disconnect(); aimbotConn = nil end
    if not on then return end
    aimbotConn = RunService.RenderStepped:Connect(function()
        if state.Aimbot and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
            local t = getClosestPlayer()
            if t and t.Character then
                local head = t.Character:FindFirstChild("Head")
                if head then Camera.CFrame = CFrame.new(Camera.CFrame.Position, head.Position) end
            end
        end
    end)
end

-- ===== ESP (viền + tên + lọc NPC/Người chơi) =====
local highlights = {}
local billboards = {}

local function isNPC(model)
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    return Players:GetPlayerFromCharacter(model) == nil
end

local function clearOneESP(p)
    if highlights[p] then highlights[p]:Destroy(); highlights[p] = nil end
    if billboards[p] then billboards[p]:Destroy(); billboards[p] = nil end
end

local function addESP(p)
    if p == player or not p.Character then return end
    local isPlayer = Players:GetPlayerFromCharacter(p.Character) ~= nil
    local isNpc = not isPlayer
    if isPlayer and not state.ESPPlayer then clearOneESP(p); return end
    if isNpc and not state.ESPNPC then clearOneESP(p); return end

    clearOneESP(p)

    local h = Instance.new("Highlight")
    h.FillTransparency = 1
    h.OutlineColor = isPlayer and Color3.fromRGB(255, 60, 60) or Color3.fromRGB(255, 200, 60)
    h.OutlineTransparency = 0
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = p.Character
    highlights[p] = h

    if state.ESPName then
        local head = p.Character:FindFirstChild("Head")
        if head then
            local bb = Instance.new("BillboardGui")
            bb.Size = UDim2.fromOffset(140, 24)
            bb.StudsOffset = Vector3.new(0, 2.5, 0)
            bb.AlwaysOnTop = true
            bb.Parent = head
            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.fromScale(1, 1)
            lbl.BackgroundTransparency = 1
            lbl.Text = p.Name
            lbl.TextColor3 = isPlayer and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(255, 200, 60)
            lbl.TextStrokeTransparency = 0
            lbl.TextScaled = true
            lbl.Font = Enum.Font.GothamBold
            lbl.Parent = bb
            billboards[p] = bb
        end
    end
end

local function clearESP()
    for p in pairs(highlights) do clearOneESP(p) end
    for p in pairs(billboards) do clearOneESP(p) end
    table.clear(highlights)
    table.clear(billboards)
end

local function setESP(on)
    clearESP()
    if on then
        for _, p in ipairs(Players:GetPlayers()) do addESP(p) end
    end
end

local function refreshESP()
    if state.ESP then setESP(true) end
end

local function watch(p)
    p.CharacterAdded:Connect(function()
        task.wait(0.5)
        if state.ESP then addESP(p) end
    end)
    p.CharacterRemoving:Connect(function() clearOneESP(p) end)
end
for _, p in ipairs(Players:GetPlayers()) do watch(p) end
Players.PlayerAdded:Connect(watch)
Players.PlayerRemoving:Connect(function(p) clearOneESP(p) end)

-- ===== FIX LAG (bản cũ) =====
local disabled = {}
local oldShadows = Lighting.GlobalShadows
local function setFPS(on)
    if on then
        oldShadows = Lighting.GlobalShadows
        Lighting.GlobalShadows = false
        pcall(function()
            local US = UserSettings and UserSettings() or nil
            if US then
                local gs = US:GetService("UserGameSettings")
                if gs then gs.SavedQualityLevel = Enum.SavedQualitySetting.QualityLevel1 end
            end
        end)
        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Smoke") or d:IsA("Fire") or d:IsA("Sparkles") then
                if d.Enabled then d.Enabled = false; table.insert(disabled, d) end
            end
        end
        for _, e in ipairs(Lighting:GetChildren()) do
            if e:IsA("PostEffect") and e.Enabled then e.Enabled = false; table.insert(disabled, e) end
        end
    else
        Lighting.GlobalShadows = oldShadows
        for _, d in ipairs(disabled) do if d.Parent then d.Enabled = true end end
        table.clear(disabled)
    end
end

-- ===== FIX LAG V2 (màn hình trắng - chỉ chừa menu) =====
local hiddenGuis = {}
local myGui -- gán sau khi tạo GUI

local function setFPSv2(on)
    if on then
        hiddenGuis = {}
        local pg = player:FindFirstChild("PlayerGui")
        if pg then
            for _, g in ipairs(pg:GetChildren()) do
                if g:IsA("ScreenGui") or g:IsA("BillboardGui") then
                    if g ~= myGui and g.Enabled then
                        g.Enabled = false
                        table.insert(hiddenGuis, g)
                    end
                end
            end
        end
        -- Tắt CoreGui (chat, leaderboard, backpack...)
        pcall(function()
            local StarterGui = game:GetService("StarterGui")
            StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)
        end)
        -- Tắt mọi hiệu ứng
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 1e6
        Lighting.Brightness = 1
        for _, e in ipairs(Lighting:GetChildren()) do
            if e:IsA("PostEffect") then e.Enabled = false end
        end
        -- Màn hình trắng hoàn toàn
        pcall(function()
            Lighting.Ambient = Color3.fromRGB(255, 255, 255)
            Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
            Lighting.EnvironmentDiffuseScale = 1
            Lighting.EnvironmentSpecularScale = 1
            Lighting.ClockTime = 12
        end)
    else
        for _, g in ipairs(hiddenGuis) do
            if g and g.Parent then g.Enabled = true end
        end
        table.clear(hiddenGuis)
        pcall(function()
            local StarterGui = game:GetService("StarterGui")
            StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, true)
        end)
        Lighting.Ambient = Color3.fromRGB(70, 70, 70)
        Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
    end
end

