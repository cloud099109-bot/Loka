local player = Players.LocalPlayer

local SPEED_VALUE, JUMP_VALUE, FLY_SPEED = 50, 120, 60
local DEFAULT_SPEED, DEFAULT_JUMP = 16, 50

local state = {
    Fly = false, FlyNoclip = false, Speed = false, HighJump = false,
    InfJump = false, ESP = false, ESPName = false, ESPNPC = false, ESPPlayer = true,
    FPS = false, FPSv2 = false, Aimbot = false,
}
local savedPosition = nil
local travelSpeed = 60
local stepDistance = 8
local travelToken = 0
local travelBusy = false

-- ===== HELPERS =====
local function getChar()
    local c = player.Character
    if not c then return end
    return c:FindFirstChildOfClass("Humanoid"), c:FindFirstChild("HumanoidRootPart")
end

local function stopTravel()
    travelToken += 1
    travelBusy = false
    local hum = getChar()
    if hum then hum.PlatformStand = false end
end

local function savePosition()
    local _, root = getChar()
    if root then savedPosition = root.CFrame; return true end
    return false
end

local function teleportToSaved()
    local _, root = getChar()
    if root and savedPosition then
        stopTravel()
        root.CFrame = savedPosition
        return true
    end
    return false
end

local function flyToSaved()
    local hum, root = getChar()
    if not hum or not root or not savedPosition or travelBusy then return end
    travelToken += 1
    local token = travelToken
    travelBusy = true
    hum.PlatformStand = true
    task.spawn(function()
        while token == travelToken do
            local _, curRoot = getChar()
            if not curRoot then break end
            local offset = savedPosition.Position - curRoot.Position
            local dist = offset.Magnitude
            if dist <= 2 then curRoot.CFrame = savedPosition; break end
            local dt = RunService.Heartbeat:Wait()
            if token ~= travelToken then break end
            local step = math.min(dist, math.max(1, travelSpeed) * math.min(dt, 0.05))
            local np = curRoot.Position + offset.Unit * step
            curRoot.CFrame = CFrame.new(np, np + curRoot.CFrame.LookVector)
        end
        local h = getChar()
        if h then h.PlatformStand = false end
        if token == travelToken then travelBusy = false end
    end)
end

local function stepTeleportToSaved()
    local _, root = getChar()
    if not root or not savedPosition or travelBusy then return end
    travelToken += 1
    local token = travelToken
    travelBusy = true
    task.spawn(function()
        while token == travelToken do
            local _, curRoot = getChar()
            if not curRoot then break end
            local offset = savedPosition.Position - curRoot.Position
            local dist = offset.Magnitude
            if dist <= stepDistance then curRoot.CFrame = savedPosition; break end
            curRoot.CFrame = curRoot.CFrame + offset.Unit * stepDistance
            task.wait(0.08)
        end
        if token == travelToken then travelBusy = false end
    end)
end

local function applyStats()
    local hum = getChar()
    if not hum then return end
    hum.WalkSpeed = state.Speed and SPEED_VALUE or DEFAULT_SPEED
    hum.UseJumpPower = true
    hum.JumpPower = state.HighJump and JUMP_VALUE or DEFAULT_JUMP
end

-- ===== FLY (CFrame-based, bay cao + xuyên tường) =====
local flyConn
local flyVel = Vector3.zero
local lastFlyUpdate = 0

local function setFly(on)
    if flyConn then flyConn:Disconnect(); flyConn = nil end
    local hum, root = getChar()
    if hum then hum.PlatformStand = false end
    if not on or not root then return end

    hum.PlatformStand = true
    flyVel = Vector3.zero

    -- Dùng RenderStepped để cập nhật CFrame trực tiếp (bay cao + xuyên tường)
    flyConn = RunService.RenderStepped:Connect(function(dt)
        local h, r = getChar()
        if not h or not r then return end

        local speed = FLY_SPEED
        local dir = h.MoveDirection

        -- Bay lên/xuống bằng Space / LeftShift
        local vert = 0
        if UIS:IsKeyDown(Enum.KeyCode.Space) then vert = 1 end
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then vert = -1 end

        -- Trên mobile: nút nhảy (Jump) = lên, không có nút xuống thì dùng nút "▼"
        if UIS.TouchEnabled then
            if h:GetState() == Enum.HumanoidStateType.Jumping then vert = 1 end
            if _G.FlyDown then vert = -1 end
        end

        local move = Vector3.new(dir.X, 0, dir.Z) * speed
        move = move + Vector3.new(0, vert * speed, 0)

        -- Di chuyển bằng CFrame (bỏ qua physics, xuyên tường, bay cao)
        r.CFrame = r.CFrame + (move * dt)
        r.Velocity = Vector3.zero
        r.RotVelocity = Vector3.zero
    end)
end

