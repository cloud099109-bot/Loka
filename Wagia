local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local Camera = workspace.CurrentCamera

local player = Players.LocalPlayer

local SPEED_VALUE, JUMP_VALUE, FLY_SPEED = 50, 120, 60
local DEFAULT_SPEED, DEFAULT_JUMP = 16, 50

local state = {
    Fly = false, FlyNoclip = false, Speed = false, HighJump = false,
    InfJump = false, ESP = false, ESPName = false, ESPNPC = false, ESPPlayer = true,
    FPS = false, FPSv2 = false, Aimbot = false,
}
local savedPosition = nil
local travelSpeed = 60
local stepDistance = 8
local travelToken = 0
local travelBusy = false

-- ===== HELPERS =====
local function getChar()
    local c = player.Character
    if not c then return end
    return c:FindFirstChildOfClass("Humanoid"), c:FindFirstChild("HumanoidRootPart")
end

local function stopTravel()
    travelToken += 1
    travelBusy = false
    local hum = getChar()
    if hum then hum.PlatformStand = false end
end

local function savePosition()
    local _, root = getChar()
    if root then savedPosition = root.CFrame; return true end
    return false
end

local function teleportToSaved()
    local _, root = getChar()
    if root and savedPosition then
        stopTravel()
        root.CFrame = savedPosition
        return true
    end
    return false
end

local function flyToSaved()
    local hum, root = getChar()
    if not hum or not root or not savedPosition or travelBusy then return end
    travelToken += 1
    local token = travelToken
    travelBusy = true
    hum.PlatformStand = true
    task.spawn(function()
        while token == travelToken do
            local _, currentRoot = getChar()
            if not currentRoot then break end
            local offset = savedPosition.Position - currentRoot.Position
            local distance = offset.Magnitude
            if distance <= 2 then currentRoot.CFrame = savedPosition; break end
            local dt = RunService.Heartbeat:Wait()
            if token ~= travelToken then break end
            local step = math.min(distance, math.max(1, travelSpeed) * math.min(dt, 0.05))
            local nextPos = currentRoot.Position + offset.Unit * step
            currentRoot.CFrame = CFrame.new(nextPos, nextPos + currentRoot.CFrame.LookVector)
        end
        local currentHum = getChar()
        if currentHum then currentHum.PlatformStand = false end
        if token == travelToken then travelBusy = false end
    end)
end

local function stepTeleportToSaved()
    local _, root = getChar()
    if not root or not savedPosition or travelBusy then return end
    travelToken += 1
    local token = travelToken
    travelBusy = true
    task.spawn(function()
        while token == travelToken do
            local _, currentRoot = getChar()
            if not currentRoot then break end
            local offset = savedPosition.Position - currentRoot.Position
            local distance = offset.Magnitude
            if distance <= stepDistance then currentRoot.CFrame = savedPosition; break end
            currentRoot.CFrame = currentRoot.CFrame + offset.Unit * stepDistance
            task.wait(0.08)
        end
        if token == travelToken then travelBusy = false end
    end)
end

local function applyStats()
    local hum = getChar()
    if not hum then return end
    hum.WalkSpeed = state.Speed and SPEED_VALUE or DEFAULT_SPEED
    hum.UseJumpPower = true
    hum.JumpPower = state.HighJump and JUMP_VALUE or DEFAULT_JUMP
end

-- ===== FLY (đã fix + xuyên tường) =====
local flyConn, flyBV, flyNoclipConn
local function setFly(on)
    if flyConn then flyConn:Disconnect(); flyConn = nil end
    if flyBV then flyBV:Destroy(); flyBV = nil end
    if flyNoclipConn then flyNoclipConn:Disconnect(); flyNoclipConn = nil end
    local hum, root = getChar()
    if hum then hum.PlatformStand = false end
    if not on or not root then return end

    hum.PlatformStand = true
    flyBV = Instance.new("BodyVelocity")
    flyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    flyBV.Velocity = Vector3.zero
    flyBV.Parent = root

    flyConn = RunService.Heartbeat:Connect(function()
        local h, r = getChar()
        if not h or not flyBV or not flyBV.Parent then return end
        local v = h.MoveDirection * FLY_SPEED
        if UIS:IsKeyDown(Enum.KeyCode.Space) then
            v = v + Vector3.new(0, FLY_SPEED, 0)
        end
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then
            v = v - Vector3.new(0, FLY_SPEED, 0)
        end
        flyBV.Velocity = v
        -- Fly xuyên tường: ép CFrame đi xuyên qua mọi vật thể
        if state.FlyNoclip and r then
            local move = (v * RunService.Heartbeat:Wait()) -- không dùng ở đây
            -- thay vào đó dùng RenderStepped bên dưới
        end
    end)

    -- Xuyên tường thực sự: cập nhật CFrame liên tục bỏ qua collision
    flyNoclipConn = RunService.RenderStepped:Connect(function(dt)
        if not state.FlyNoclip then return end
        local h, r = getChar()
        if not h or not r then return end
        local move = h.MoveDirection * FLY_SPEED * dt
        if UIS:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.new(0, FLY_SPEED * dt, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then move -= Vector3.new(0, FLY_SPEED * dt, 0) end
        r.CFrame = r.CFrame + move
    end)
end

